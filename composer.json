{
    "name": "opencck/mercurius",
    "description": "Mercurius: an autonomous personal agent on AMPHP v3 and opencck",
    "type": "project",
    "license": "MIT",
    "require": {
        "ext-json": "*",
        "ext-sodium": "*",
        "php": ">=8.2",
        "amphp/amp": "^3",
        "amphp/file": "3.2.0 as 4.0.0",
        "amphp/http-client": "^5",
        "amphp/http-server-form-parser": "^2",
        "amphp/log": "^2",
        "amphp/postgres": "^2.2",
        "amphp/ssh": "dev-master",
        "amphp/websocket-client": "^2.0",
        "monolog/monolog": "^3",
        "opencck/mercurius-connectors": "dev-master",
        "opencck/mercurius-i18n": "dev-master",
        "opencck/mercurius-llm": "dev-master",
        "opencck/mercurius-mcp-client": "dev-master",
        "opencck/mercurius-memory": "dev-master",
        "opencck/mercurius-messenger": "dev-master",
        "opencck/mercurius-peer": "dev-master",
        "opencck/mercurius-search": "dev-master",
        "opencck/mercurius-todo": "dev-master",
        "opencck/server": "^1.1.1",
        "psr/log": "^3",
        "revolt/event-loop": "^1",
        "vlucas/phpdotenv": "^5.6",
        "wamania/php-stemmer": "^4.0"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.22.2",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "OpenCCK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCCK\\Test\\": "test/"
        }
    },
    "config": {
        "process-timeout": 900,
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php -d memory_limit=512M -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit --exclude-group integration,sandbox",
        "test-integration": "php -d memory_limit=512M -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit --group integration",
        "test-sandbox": "php -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit --group sandbox",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-progress --show-info=false",
        "check": [
            "@test",
            "@phpstan",
            "@psalm",
            "@spec-links"
        ],
        "spec-links": "php bin/spec-links.php"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/llm",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-llm": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/connectors",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-connectors": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/messenger",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-messenger": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/i18n",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-i18n": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/search",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-search": "dev-master"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/rekryt/amphp-ssh"
        },
        {
            "type": "path",
            "url": "packages/mcp-client",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-mcp-client": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/memory",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-memory": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/todo",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-todo": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/peer",
            "options": {
                "symlink": false,
                "versions": {
                    "opencck/mercurius-peer": "dev-master"
                }
            }
        }
    ],
    "minimum-stability": "stable"
}
