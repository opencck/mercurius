{
    "name": "opencck/mercurius",
    "description": "Mercurius: an autonomous personal agent on AMPHP v3 and opencck",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "opencck/server": "^1.1.1",
        "amphp/amp": "^3",
        "amphp/file": "^3",
        "amphp/log": "^2",
        "amphp/postgres": "^2.2",
        "monolog/monolog": "^3",
        "psr/log": "^3",
        "revolt/event-loop": "^1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.22.2",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "OpenCCK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCCK\\Test\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit --exclude-group integration",
        "test-integration": "php -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit --group integration",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-progress --show-info=false",
        "check": [
            "@test",
            "@phpstan",
            "@psalm"
        ]
    }
}
