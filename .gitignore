# Секреты и локальные настройки
.env
.env.*
!.env.example

# Локальные настройки Claude Code и MCP: содержат адрес сервера и пароль
.mcp.json
.claude/settings.local.json

# Локальные скиллы без своего репозитория (скиллы-сабмодули в git входят)
.claude/skills/skill-opencck/
.claude/skills/graphify/

# Граф знаний graphify — генерируется локально командой /graphify
graphify-out/

# Зависимости PHP (composer.lock коммитится)
/vendor/

# Кеши и отчёты PHPUnit, PHPStan, Psalm
.phpunit.cache/
.phpunit.result.cache
/var/cache/
/coverage/
# Локальная настройка PHPStan; в git — phpstan.neon.dist
phpstan.neon

# Данные во время работы — каталоги проекта, смонтированные в контейнеры: storage/app (приложение),
# storage/postgres (база), storage/workspace (рабочие каталоги участников в песочнице). Сами каталоги
# в git есть (.keep), их содержимое — нет.
/storage/*
!/storage/*/
/storage/*/*
!/storage/*/.keep
/var/log/
*.log

# Локальное переопределение Docker Compose
docker-compose.override.yml
compose.override.yaml

# IDE и операционные системы
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
