# Настройки Меркурия. Здесь — связь с Telegram, база, Compose, мастер-ключ хранилища и начальные ключи моделей.
# Остальное (модели, лимиты, поиск, время, память…) — начальные значения: владелец меняет их в диалоге
# (/settings, /set <ключ> <значение>, /restart), сохранённое в диалоге важнее этого файла. spec: BRIEF.md#настройки-агента

# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Docker Compose
COMPOSE_PROJECT_NAME=mercurius
# Тег образов приложения, песочницы и браузера (общие для экземпляров на одном хосте); по умолчанию dev
# APP_VERSION=dev
COMPOSE_FILE=docker-compose.yml

# Токен Telegram-бота Меркурия (выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram user id первого владельца (число): он создаётся при первом сообщении; дальше владение
# передаётся командой /owner, и эта переменная уже не меняет владельца
TELEGRAM_ADMIN_ID=

# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# VLESS-маршрут для исходящих запросов к OpenRouter (vless://...).
# Задан — запросы к модели идут через VPN; пусто — напрямую. Поддерживаются транспорты
# tcp, ws, httpupgrade, grpc, xhttp с TLS; REALITY и Vision не поддерживаются.
VLESS_URI=
# Как бот получает обновления: webhook (по умолчанию при заданном APP_URL) или polling (APP_URL остаётся для сети агентов)
TELEGRAM_MODE=
# Путь к Telegram: пусто — напрямую; vless — через VLESS_URI; или прокси socks5h://user:pass@host:1080, http://host:3128
TELEGRAM_PROXY=
# Модули в своих профилях compose, через запятую (по умолчанию ни одного): browser, mail, media-video, media-docs, telegram-api.
# Локальный сервер Telegram Bot API (по умолчанию выключен — облачный Bot API): включить — COMPOSE_PROFILES=telegram-api
# и TELEGRAM_API_URL=http://telegram-api:8081; api_id и api_hash — с my.telegram.org. Файлы до 2000 МБ
COMPOSE_PROFILES=
TELEGRAM_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Предел файла с локальным сервером, МБ (облако — всегда 20)
TELEGRAM_FILE_LIMIT_MB=200

# Модель по умолчанию — запасная: модель диалога выбирается по таблице ролей (таблица model_roles)
LLM_MODEL=z-ai/glm-5.3-flash
# Усилие рассуждения: none, minimal, low, medium, high, xhigh, max
LLM_REASONING_EFFORT=low
# Предел токенов одного ответа модели
LLM_MAX_TOKENS=4096
# Сообщений прошлых запусков диалога, которые видит модель
LLM_HISTORY_LIMIT=40
# Окно контекста основной модели в токенах (до каталога моделей); сжатие — с 75% окна, с 50% для окон от 512 тыс.
LLM_CONTEXT_WINDOW=131072
# Списки моделей, из которых агент выбирает сам (через запятую, первая — по умолчанию): дешёвая (вспомогательные вызовы),
# основная и сильная. Пусто — в списке одна LLM_MODEL. Модель вне списков агент не вызывает
LLM_CHEAP_MODELS=
LLM_MAIN_MODELS=
LLM_STRONG_MODELS=

# Публичный адрес сервиса, например https://mercurius.example.com.
# Задан — Telegram через webhook; пуст — long polling (локальная разработка).
APP_URL=
# Секрет вебхука Telegram (A-Z, a-z, 0-9, _ и -, до 256 символов), проверяется в заголовке
# X-Telegram-Bot-Api-Secret-Token. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Подсистемы приложения
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info
SYS_TIMEZONE=UTC

# PostgreSQL (контейнер postgres в compose)
POSTGRES_DB=mercurius
POSTGRES_USER=mercurius
POSTGRES_PASSWORD=

# Лимиты одного запуска агента (лимиты владельца и потолок для остальных участников)
# Вызовов модели на запуск
AGENT_MAX_TURNS=750
# Токенов (вход + выход) на запуск
AGENT_TOKEN_BUDGET=1000000
# Секунд на запуск, без времени ожидания подтверждения
AGENT_RUN_TIMEOUT=28800
# Секунд на вызов инструмента по умолчанию (не больше 600)
AGENT_TOOL_TIMEOUT=120
# Язык агента: ru, en или zh (китайский, упрощённое письмо) — то, что агент пишет сам; меняется и командой /set
AGENT_LANGUAGE=ru
# Секунд на ответ владельца по карточке подтверждения; молчание — отказ (не больше суток)
AGENT_APPROVAL_TIMEOUT=1800
# Воркеры (делегирование): ходов на воркера и токенов на воркера (берутся из бюджета запуска-оркестратора)
AGENT_WORKER_MAX_TURNS=375
AGENT_WORKER_TOKEN_BUDGET=500000
# Tools a worker may get, comma-separated (name* for a prefix); a tool not here, a new one too, a worker does not get
AGENT_WORKER_TOOLS=read_file,list_files,search_files,write_file,run_command,git,checkpoint,http_request,web_search,web_read,browser,documents,media,skill_view,self_info,servers,ssh_run,sql_query,file_write,tcp_probe
# 1 — clicks and sending forms in the browser wait for the owner's card; 0 (default) — they go without one (an accepted risk)
BROWSER_CONFIRM=0
# Cap on the number of files of an imported skill; 0 (default) — no cap, and a skill has no size limit either
SKILL_MAX_FILES=0
# The rule to act through tools for models that tend to answer in prose: auto (by families: gpt, codex, gemini, gemma,
# grok, glm, qwen, deepseek, muse), on, off, or parts of model names, comma-separated
AGENT_TOOL_USE_GUIDANCE=auto

# Песочница: контейнер, где агент выполняет команды и работает с файлами
# Токен исполнителя песочницы (секрет только песочницы). Пусто — песочница выключена.
# Сгенерировать: openssl rand -hex 32
SANDBOX_TOKEN=
SANDBOX_URL=http://sandbox:9000
# Потолки памяти приложения и базы (обычно приложению хватает ~100 МБ, базе — ~600 МБ)
APP_MEMORY=1g
POSTGRES_MEMORY=2g
# Лимиты контейнера песочницы (общий потолок)
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_PIDS=512
# Размер рабочего каталога участника (проверяет исполнитель)
SANDBOX_WORKSPACE_LIMIT=5g
# Лимиты одной команды: процессы участника (заметно меньше SANDBOX_PIDS), процессорное время, адресное пространство
# (0 — без предела, по умолчанию: WebAssembly в Node резервирует ~10 ГБ адресов; настоящую память держит SANDBOX_MEMORY),
# одновременные команды участника
SANDBOX_COMMAND_PROCESSES=128
SANDBOX_COMMAND_CPU_SECONDS=600
SANDBOX_COMMAND_MEMORY=0
SANDBOX_CONCURRENT_COMMANDS=4

# Трассы: сколько дней хранить полные промпты и ответы модели (секреты в них замаскированы)
TRACE_RETENTION_DAYS=14

# Ключ отпечатков забытых фактов (HMAC): забытый текст нельзя записать снова. Пуст — ключ выводится из токена бота
MEMORY_SECRET=
# Вес HRR в порядке фактов, которые слова оценили почти одинаково, от 0 до 1 (0 — только слова). Замер — brief/memory.md
MEMORY_HRR_WEIGHT=0.3
# Час ночной проверки памяти (UTC, 0–23): дубликаты, противоречия, неиспользуемое, страж потерь; модель не вызывается
MEMORY_CHECK_HOUR=3
# Через сколько ходов человека дешёвая модель предлагает факты для памяти — через карточку владельца; 0 — выключено
MEMORY_NUDGE_TURNS=10
# Предел MEMORY.md (в личном чате, в проекте, в группе) в символах: правила идут целиком, заметки — сколько влезет;
# с 85 % агент сжимает файл
MEMORY_FILE_LIMIT=4000
# 1 — сообщать об изменении раздела «Правила» MEMORY.md с кнопкой «Убрать» (откат); 0 — молча, отката нет.
# Действует сразу, без перезапуска
MEMORY_RULES_NOTICE=0
# Модели сна памяти через запятую (ночная проверка фактов): пусто — сна нет, страж потерь работает всегда.
# Действует сразу, без перезапуска
MEMORY_SLEEP_MODELS=
# 1 — сон дописывает фактам и переводы слов поиска на два других языка памяти (русский, английский, китайский);
# 0 — только слова на языке самого факта. Действует сразу, без перезапуска
MEMORY_SLEEP_TRANSLATE=0
# Какие правки сон делает сам, без карточки, через запятую: copy — снять явную копию, merge — слить, conflict — снять
# факт, который уверенно заменён более новым. Пусто — всё карточками владельцу. Каждая правка — в отчёте,
# отмена — /dream undo <номер>. Действует сразу, без перезапуска
MEMORY_SLEEP_AUTO=
# Поиск в интернете: поставщики по порядку — searxng, brave, tavily, openrouter (сбой одного — следующий).
# Поставщик без своей настройки пропускается. По умолчанию — openrouter
SEARCH_PROVIDERS=openrouter
# Адрес своего SearXNG (с форматом json), например http://searxng:8080
SEARXNG_URL=
# Ключ Brave Search API (есть бесплатный тариф)
BRAVE_SEARCH_API_KEY=
# Ключ Tavily
TAVILY_API_KEY=
# Модели OpenRouter для поиска (с веб-плагином), через запятую; нужен OPENROUTER_API_KEY. Пусто — поиска через OpenRouter нет
WEB_SEARCH_MODELS=

# Вложения во входящих (BRIEF.md → Входящие вложения). Модели по умолчанию не заданы: пока модель вида не названа,
# агент этот вид не смотрит. Ссылки через запятую: openrouter:author/slug (или голый author/slug), openai:model,
# codex:model, anthropic:model, bedrock:anthropic.model,
# custom:<имя из MEDIA_ENDPOINTS>/model; порядок — порядок предпочтения (дешёвую ставьте первой). Здесь — только
# начальный набор: владелец и агент меняют его в диалоге (/set, инструмент settings), сохранённое значение важнее .env
MEDIA_VISION_MODELS=
MEDIA_VIDEO_MODELS=
MEDIA_SPEECH_MODELS=
# Модели, которые рисуют картинки (только OpenRouter: openrouter:author/slug). Пусто — агент не рисует
MEDIA_IMAGE_MODELS=
# Генерация звука и генерация видео: категории заведены, инструментов пока нет
MEDIA_AUDIO_GEN_MODELS=
MEDIA_VIDEO_GEN_MODELS=
# Принципы выбора модели для вида, текстом: «обычные фото — glm-5.3-flash; чеки и документы — claude-haiku-5.5»
MEDIA_VISION_RULES=
MEDIA_VIDEO_RULES=
MEDIA_SPEECH_RULES=
MEDIA_IMAGE_RULES=
# Свои модели с API, совместимым с OpenAI: имя=адрес через запятую (ключ — секрет media-endpoint-<имя>)
MEDIA_ENDPOINTS=
# Что обрабатывать сразу: voice, audio, image, video, text, office или none; остальное — по запросу
MEDIA_AUTO=voice,audio,image,text,office
# Аудио длиннее стольких минут сразу не распознаётся
MEDIA_AUDIO_AUTO_MINUTES=10
# Сколько символов текста документа идёт в сообщение
MEDIA_TEXT_LIMIT=20000
# Сколько дней хранить пришедшие файлы в inbox/
MEDIA_INBOX_DAYS=30
# Модуль media-video (ffmpeg: кадры и звук видео, если модели видео нет). Включить — добавить media-video в
# COMPOSE_PROFILES и задать токен (не короче 16 символов, openssl rand -hex 24). Пусто — модуля нет
MEDIA_VIDEO_TOKEN=
# MEDIA_VIDEO_URL=http://media-video:8091
# Модуль media-docs (текст docx, pptx, xlsx, odt, PDF, RTF и новые docx, xlsx, pptx). Включить — добавить media-docs в
# COMPOSE_PROFILES и задать токен. Пусто — модуля нет: документы только сохраняются
MEDIA_DOCS_TOKEN=
# MEDIA_DOCS_URL=http://media-docs:8092
# Модуль browser (Chromium): добавить browser в COMPOSE_PROFILES и задать токен (не короче 16 символов,
# openssl rand -hex 24). Пусто — браузера у агента нет
BROWSER_TOKEN=
# Адрес сервиса браузера в сети compose
BROWSER_URL=http://browser:3000
# Часовой пояс владельца (IANA, например Europe/Moscow, или смещение +03:00): расписание daily, тихие часы, сводка.
# По умолчанию +03:00
OWNER_TIMEZONE=+03:00
# Тихие часы по поясу владельца «с-до»: итоги заданий в это время ждут утра. Пусто — без тихих часов
QUIET_HOURS=23-8
# Токенов на один запуск задания (не больше бюджета владельца AGENT_TOKEN_BUDGET)
JOB_TOKEN_BUDGET=300000
# Токенов в день на группу, пока агент в свободном режиме вмешивается сам; дальше — только когда к нему обращаются (0 — без лимита)
GROUP_FREE_DAILY_TOKENS=200000
# Инициатива агента: по этому расписанию (daily:ЧЧ:ММ, every:<минуты>, weekly:mon,thu@10:00) агент сам смотрит проекты,
# сроки и заметки и пишет владельцу, только если есть что сказать. Пусто — выключено
INITIATIVE_SCHEDULE=
# Сообщений по инициативе агента в сутки (итоги заданий, инициатива); сверх — ждут следующего дня. 0 — без предела
INITIATIVE_PER_DAY=6
# Самоулучшение (агент предлагает, владелец утверждает): по этому расписанию агент разбирает свои трассы за неделю и
# присылает предложения карточками. Пусто — выключено
SELF_REVIEW_SCHEDULE=weekly:sun@20:00
# Судья набора проверочных задач при проверке изменения промпта — модель другой семьи, чем LLM_MODEL. Пусто — изменения
# промпта не включаются. Любой провайдер с ключом (openai:…, openrouter:…); jev:<модель> — сервис-судья Jev
# (jev:jev-latest, нужен JEV_API_KEY)
EVAL_JUDGE_MODEL=anthropic/claude-haiku-5.5
# Ключ сервиса-судьи Jev (jev-ai.pro), для EVAL_JUDGE_MODEL=jev:…; пусто — Jev не используется
JEV_API_KEY=
# Прогонов каждой задачи (не меньше 3); прогон платный: 22 задачи × прогоны × 2 версии
EVAL_RUNS=3
# Мастер-ключ хранилища секретов: 32 байта в base64 (openssl rand -base64 32). Пусто — хранилище и SSH выключены.
# Сменить ключ — значит потерять расшифровку сохранённых секретов: перед сменой выгрузите и сохраните их заново
SECRETS_KEY=
# Группы серверов, где каждая команда (и чтение) ждёт подтверждения владельца, через запятую, например: prod
SSH_CONFIRM_GROUPS=
# Токен для GET /metrics (Prometheus, заголовок Authorization: Bearer). Пусто — адрес выключен
METRICS_TOKEN=

# Ключ OpenAI API: второй провайдер моделей. Нужен хотя бы один из ключей OPENROUTER_API_KEY, OPENAI_API_KEY
# и ANTHROPIC_API_KEY; запросы ко всем идут через VLESS, если задан VLESS_URI
OPENAI_API_KEY=
# Ключ Anthropic API: Claude напрямую, модели вида anthropic:claude-sonnet-5-5. Задан только он — модели
# по умолчанию anthropic:claude-sonnet-5-5 и anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# Ключ Amazon Bedrock API (токен на предъявителя): Claude в Bedrock, модели вида bedrock:anthropic.claude-sonnet-5-5.
# Подпись SigV4 не поддерживается — только ключ. Задан только он — модели по умолчанию
# bedrock:anthropic.claude-sonnet-5-5 и bedrock:anthropic.claude-haiku-5-5
AWS_BEARER_TOKEN_BEDROCK=
# Регион Bedrock; пусто — us-east-1
BEDROCK_REGION=

# Лимиты расхода в долларах по всем запускам (воркеры, фон, сжатие); 0 — без лимита. При достижении новые вызовы
# моделей не начинаются до следующих суток (месяца) или до повышения лимита
AGENT_DAILY_SPEND_CAP=0
AGENT_MONTHLY_SPEND_CAP=0
# Запусков воркеров на один запуск, повторы и проверяющие вместе
AGENT_MAX_WORKERS_PER_RUN=10

# Второй и следующие экземпляры на одном хосте: своё имя в сети web и своя подсеть песочницы
# (для неё нужно своё правило файрвола DOCKER-USER). Пусто — mercurius и 172.31.250.0/24
WEB_ALIAS=
SANDBOX_SUBNET=

# Сеть агентов (A2A): токен входа в /a2a этого экземпляра (openssl rand -hex 32) — его дают ведущему агенту,
# он хранит его как секрет. Кто говорит, агенты узнают по ключам ECDSA (ключ этого агента — в хранилище секретов).
# Пусто (или нет APP_URL, SECRETS_KEY) — вход по A2A выключен
A2A_TOKEN=
# Как к этому агенту подключаются соседи: ws — WebSocket /a2a/ws, ключ проверяется один раз после подключения
# (по умолчанию); http — POST /a2a, каждый запрос подписан (так подключаются и сторонние агенты A2A). Работает только
# выбранный способ
A2A_TRANSPORT=ws
# Как идут файлы к соседям: http — заранее по POST /a2a/files (form-data, по умолчанию); ws — байтами в сообщении по
# WebSocket (кадр после проверки ключей — до 28 МБ). Вход для файлов есть при любом A2A_TRANSPORT
A2A_FILE_TRANSPORT=http

# Встроенный сервер почты (MCP, модуль mcp/mail; включить — добавить mail в COMPOSE_PROFILES): токен входа (openssl rand -hex 32).
# Ящиков здесь нет: каждый участник с правом mail подключает свой в диалоге (пароль — в хранилище через /secret). Пусто — почты у агента нет
MAIL_MCP_TOKEN=
# Адрес встроенного MCP почты; по умолчанию — сервис compose
# MAIL_MCP_URL=http://mail-mcp:8090/mcp
