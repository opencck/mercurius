# Настройки Меркурия. Здесь — связь с Telegram, база, Compose, мастер-ключ хранилища и начальные ключи моделей.
# Остальное (модели, лимиты, поиск, время, память…) — начальные значения: владелец меняет их в диалоге
# (/settings, /set <ключ> <значение>, /restart), сохранённое в диалоге важнее этого файла. spec: BRIEF.md#настройки-агента

# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Docker Compose
COMPOSE_PROJECT_NAME=mercurius
# Тег образов приложения, песочницы и браузера (общие для экземпляров на одном хосте); по умолчанию dev
# APP_VERSION=dev
COMPOSE_FILE=docker-compose.yml

# Токен Telegram-бота Меркурия (выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram user id администратора (число)
TELEGRAM_ADMIN_ID=

# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# VLESS-маршрут для исходящих запросов к OpenRouter (vless://...).
# Задан — запросы к модели идут через VPN; пусто — напрямую. Поддерживаются транспорты
# tcp, ws, httpupgrade, grpc, xhttp с TLS; REALITY и Vision не поддерживаются.
VLESS_URI=

# Модель по умолчанию — запасная: модель диалога выбирается по таблице ролей (таблица model_roles)
LLM_MODEL=z-ai/glm-5.3-flash
# Усилие рассуждения: none, minimal, low, medium, high, xhigh, max
LLM_REASONING_EFFORT=low
# Предел токенов одного ответа модели
LLM_MAX_TOKENS=4096
# Сообщений прошлых запусков диалога, которые видит модель
LLM_HISTORY_LIMIT=40
# Окно контекста основной модели в токенах (до каталога моделей); сжатие — с 75% окна, с 50% для окон от 512 тыс.
LLM_CONTEXT_WINDOW=131072
# Дешёвая модель вспомогательных вызовов (резюме при сжатии контекста)
LLM_CHEAP_MODEL=openai/gpt-5.6-luna

# Публичный адрес сервиса, например https://mercurius.example.com.
# Задан — Telegram через webhook; пуст — long polling (локальная разработка).
APP_URL=
# Секрет вебхука Telegram (A-Z, a-z, 0-9, _ и -, до 256 символов), проверяется в заголовке
# X-Telegram-Bot-Api-Secret-Token. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Подсистемы приложения
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info
SYS_TIMEZONE=UTC

# PostgreSQL (контейнер postgres в compose)
POSTGRES_DB=mercurius
POSTGRES_USER=mercurius
POSTGRES_PASSWORD=

# Лимиты одного запуска агента (лимиты владельца и потолок для остальных участников)
# Вызовов модели на запуск
AGENT_MAX_TURNS=30
# Токенов (вход + выход) на запуск
AGENT_TOKEN_BUDGET=400000
# Секунд на запуск, без времени ожидания подтверждения
AGENT_RUN_TIMEOUT=900
# Секунд на вызов инструмента по умолчанию (не больше 600)
AGENT_TOOL_TIMEOUT=120
# Язык агента: ru или en (то, что агент пишет сам; меняется и командой /set)
AGENT_LANGUAGE=ru
# Секунд на ответ владельца по карточке подтверждения; молчание — отказ (не больше суток)
AGENT_APPROVAL_TIMEOUT=1800
# Воркеры (делегирование): ходов на воркера и токенов на воркера (берутся из бюджета запуска-оркестратора)
AGENT_WORKER_MAX_TURNS=15
AGENT_WORKER_TOKEN_BUDGET=100000

# Песочница: контейнер, где агент выполняет команды и работает с файлами
# Токен исполнителя песочницы (секрет только песочницы). Пусто — песочница выключена.
# Сгенерировать: openssl rand -hex 32
SANDBOX_TOKEN=
SANDBOX_URL=http://sandbox:9000
# Лимиты контейнера песочницы (общий потолок)
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
SANDBOX_PIDS=512
# Размер рабочего каталога участника (проверяет исполнитель)
SANDBOX_WORKSPACE_LIMIT=5g
# Лимиты одной команды: процессы участника (заметно меньше SANDBOX_PIDS), процессорное время, адресное пространство,
# одновременные команды участника
SANDBOX_COMMAND_PROCESSES=128
SANDBOX_COMMAND_CPU_SECONDS=600
SANDBOX_COMMAND_MEMORY=8g
SANDBOX_CONCURRENT_COMMANDS=4

# Трассы: сколько дней хранить полные промпты и ответы модели (секреты в них замаскированы)
TRACE_RETENTION_DAYS=14

# Ключ отпечатков забытых фактов (HMAC): забытый текст нельзя записать снова. Пуст — ключ выводится из токена бота
MEMORY_SECRET=
# Доля HRR в оценке вспомненного факта, от 0 до 1 (0 — только слова). Замер на русском наборе — в BRIEF.md
MEMORY_HRR_WEIGHT=0.3
# Час ночной проверки памяти (UTC, 0–23): дубликаты, противоречия, неиспользуемое, страж потерь; модель не вызывается
MEMORY_CHECK_HOUR=3
# Поиск в интернете: поставщики по порядку — searxng, brave, tavily, openrouter (сбой одного — следующий).
# Поставщик без своей настройки пропускается. По умолчанию — openrouter
SEARCH_PROVIDERS=openrouter
# Адрес своего SearXNG (с форматом json), например http://searxng:8080
SEARXNG_URL=
# Ключ Brave Search API (есть бесплатный тариф)
BRAVE_SEARCH_API_KEY=
# Ключ Tavily
TAVILY_API_KEY=
# Модель OpenRouter для поиска (с веб-плагином); нужен OPENROUTER_API_KEY
WEB_SEARCH_MODEL=openai/gpt-5.6-luna
# Токен сервиса браузера (не короче 16 символов, openssl rand -hex 24). Пусто — браузера у агента нет
BROWSER_TOKEN=
# Адрес сервиса браузера в сети compose
BROWSER_URL=http://browser:3000
# Часовой пояс владельца (IANA, например Europe/Moscow, или смещение +03:00): расписание daily, тихие часы, сводка.
# По умолчанию +03:00
OWNER_TIMEZONE=+03:00
# Тихие часы по поясу владельца «с-до»: итоги заданий в это время ждут утра. Пусто — без тихих часов
QUIET_HOURS=23-8
# Токенов на один запуск задания (не больше бюджета владельца AGENT_TOKEN_BUDGET)
JOB_TOKEN_BUDGET=100000
# Токенов в день на группу, пока агент в свободном режиме вмешивается сам; дальше — только когда к нему обращаются (0 — без лимита)
GROUP_FREE_DAILY_TOKENS=200000
# Время ежедневной сводки дел владельцу (ЧЧ:ММ по OWNER_TIMEZONE): просроченное, сроки на сегодня и завтра, задания дня.
# Пусто — сводка только по команде /digest
DIGEST_TIME=
# Мастер-ключ хранилища секретов: 32 байта в base64 (openssl rand -base64 32). Пусто — хранилище и SSH выключены.
# Сменить ключ — значит потерять расшифровку сохранённых секретов: перед сменой выгрузите и сохраните их заново
SECRETS_KEY=
# Группы серверов, где каждая команда (и чтение) ждёт подтверждения владельца, через запятую, например: prod
SSH_CONFIRM_GROUPS=
# Токен для GET /metrics (Prometheus, заголовок Authorization: Bearer). Пусто — адрес выключен
METRICS_TOKEN=

# Ключ OpenAI API: второй провайдер моделей. Нужен хотя бы один из ключей OPENROUTER_API_KEY и OPENAI_API_KEY;
# запросы к обоим идут через VLESS, если задан VLESS_URI
OPENAI_API_KEY=

# Лимиты расхода в долларах по всем запускам (воркеры, фон, сжатие); 0 — без лимита. При достижении новые вызовы
# моделей не начинаются до следующих суток (месяца) или до повышения лимита
AGENT_DAILY_SPEND_CAP=0
AGENT_MONTHLY_SPEND_CAP=0
# Запусков воркеров на один запуск, повторы и проверяющие вместе
AGENT_MAX_WORKERS_PER_RUN=10

# Второй и следующие экземпляры на одном хосте: своё имя в сети web и своя подсеть песочницы
# (для неё нужно своё правило файрвола DOCKER-USER). Пусто — mercurius и 172.31.250.0/24
WEB_ALIAS=
SANDBOX_SUBNET=

# Сеть агентов (A2A): токен входа в /a2a этого экземпляра (openssl rand -hex 32) — его дают ведущему агенту,
# он хранит его как секрет. Кто говорит, агенты узнают по ключам ECDSA (ключ этого агента — в хранилище секретов).
# Пусто (или нет APP_URL, SECRETS_KEY) — вход по A2A выключен
A2A_TOKEN=
# Как к этому агенту подключаются соседи: ws — WebSocket /a2a/ws, ключ проверяется один раз после подключения
# (по умолчанию); http — POST /a2a, каждый запрос подписан (так подключаются и сторонние агенты A2A). Работает только
# выбранный способ
A2A_TRANSPORT=ws

# Встроенный сервер почты (MCP, сервис mail-mcp): токен входа (openssl rand -hex 32). Ящик — в настройках агента
# (/set MAIL_HOST …, MAIL_USER, MAIL_PASSWORD, MAIL_IMAP_PORT, MAIL_SMTP_PORT). Пусто — почты у агента нет
MAIL_MCP_TOKEN=
# Адрес встроенного MCP почты; по умолчанию — сервис compose
# MAIL_MCP_URL=http://mail-mcp:8090/mcp
