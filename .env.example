# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Docker Compose
COMPOSE_PROJECT_NAME=mercurius
COMPOSE_FILE=docker-compose.yml

# Токен Telegram-бота Меркурия (выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram user id администратора (число)
TELEGRAM_ADMIN_ID=

# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# VLESS-маршрут для исходящих запросов к OpenRouter (vless://...).
# Задан — запросы к модели идут через VPN; пусто — напрямую. Поддерживаются транспорты
# tcp, ws, httpupgrade, grpc, xhttp с TLS; REALITY и Vision не поддерживаются.
VLESS_URI=

# Публичный адрес сервиса, например https://mercurius.example.com.
# Задан — Telegram через webhook; пуст — long polling (локальная разработка).
APP_URL=
# Секрет вебхука Telegram (A-Z, a-z, 0-9, _ и -, до 256 символов), проверяется в заголовке
# X-Telegram-Bot-Api-Secret-Token. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Подсистемы приложения
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info
SYS_TIMEZONE=UTC

# PostgreSQL (контейнер postgres в compose)
POSTGRES_DB=mercurius
POSTGRES_USER=mercurius
POSTGRES_PASSWORD=

# Лимиты одного запуска агента (лимиты владельца и потолок для остальных участников)
# Вызовов модели на запуск
AGENT_MAX_TURNS=30
# Токенов (вход + выход) на запуск
AGENT_TOKEN_BUDGET=400000
# Секунд на запуск, без времени ожидания подтверждения
AGENT_RUN_TIMEOUT=900
# Секунд на вызов инструмента по умолчанию (не больше 600)
AGENT_TOOL_TIMEOUT=120
# Секунд на ответ владельца по карточке подтверждения; молчание — отказ (не больше суток)
AGENT_APPROVAL_TIMEOUT=1800

# Песочница: контейнер, где агент выполняет команды и работает с файлами
# Токен исполнителя песочницы (секрет только песочницы). Пусто — песочница выключена.
# Сгенерировать: openssl rand -hex 32
SANDBOX_TOKEN=
SANDBOX_URL=http://sandbox:9000
# Лимиты контейнера песочницы (общий потолок)
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
SANDBOX_PIDS=512
# Размер рабочего каталога участника (проверяет исполнитель)
SANDBOX_WORKSPACE_LIMIT=5g
# Лимиты одной команды: процессы участника (заметно меньше SANDBOX_PIDS), процессорное время, адресное пространство,
# одновременные команды участника
SANDBOX_COMMAND_PROCESSES=128
SANDBOX_COMMAND_CPU_SECONDS=600
SANDBOX_COMMAND_MEMORY=8g
SANDBOX_CONCURRENT_COMMANDS=4
